platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Xcode 15+: evita que fases de build tratem artefatos em `build/ios/...` como "stale" /
# fora dos root paths permitidos (ex.: share_plus.framework após trocar pods ou limpar mal).
install! 'cocoapods', :disable_input_output_paths => true

# Se aparecer: Stale file '.../build/ios/Debug-iphoneos/path_provider_foundation/
# path_provider_foundation_privacy.bundle' is located outside of the allowed root paths
# — é cache misturando Flutter (pasta build/ do projeto) com DerivedData do Xcode.
# 1) Na raiz do projeto:  bash scripts/ios_clean_stale_build.sh
# 2) Só use ios/Runner.xcworkspace (não o .xcodeproj).
# 3) Xcode → Settings → Locations → Derived Data: "Default" (evita caminho legacy).
# 4) Depois do clean: Product → Clean Build Folder (⇧⌘K).
# 5) Preferir `flutter run` / `flutter build ios` em vez de Archive direto no Xcode, se possível.
#
# Arranque no ícone / sem cabo (iOS 26 + ProMotion): use o Xcode scheme **Runner-Dispositivo**
# (Release) ou `flutter run --release` — Debug no dispositivo pode crashar fora do debugger (#183900).

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # Estático: em Xcode 16+ com frameworks dinâmicos, headers Swift dos plugins
  # (`@import Flutter`) costumam falhar com "module 'Flutter' not found".
  use_frameworks! :linkage => :static
  # Sem use_modular_headers!: com ele, o módulo app_links expõe app_links-Swift.h com
  # @import Flutter e o Clang falha ("module 'Flutter' not found") ao compilar o Runner.

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # PrivacyInfo.xcprivacy não é código-fonte; podspecs com `**/*` metem-no em Compile Sources
    # e o Xcode acusa: "no rule to process file ... xcprivacy ... for architecture arm64".
    # Preferir source_build_phase (API do xcodeproj) — em alguns ambientes `phase.class.name`
    # não termina em PBXSourcesBuildPhase e o bloco antigo não removia nada.
    sources_phase = target.respond_to?(:source_build_phase) ? target.source_build_phase : nil
    if sources_phase
      sources_phase.files.to_a.each do |bf|
        ref = bf.file_ref
        path = ref&.path.to_s
        real = (ref.respond_to?(:real_path) && ref.real_path) ? ref.real_path.to_s : ''
        next unless path.end_with?('.xcprivacy') || real.end_with?('.xcprivacy')
        sources_phase.remove_build_file(bf)
      end
    else
      target.build_phases.each do |phase|
        next unless phase.class.name.end_with?('PBXSourcesBuildPhase')
        phase.files.to_a.each do |bf|
          path = bf.file_ref&.path.to_s
          next unless path.end_with?('.xcprivacy')
          phase.remove_build_file(bf)
        end
      end
    end

    # Xcode 16+: módulos Swift explícitos às vezes falham ao resolver `@import Flutter` em plugins.
    target.build_configurations.each do |config|
      config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      # Evita "module 'Flutter' not found" ao compilar app_links-Swift.h / @import app_links no Runner.
      config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'
      # Menos verificação de módulo Swift: reduz atrito com privacy bundles dos plugins no Xcode 16+.
      config.build_settings['SWIFT_VERIFY_EMITTED_MODULE_INTERFACE'] = 'NO'

      # Xcode 16+: pods com IPHONEOS_DEPLOYMENT_TARGET 9.0 geram aviso (mínimo suportado 12+).
      dt = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_s
      if dt.empty? || (dt !~ /\$\(/ && dt.to_f < 12.0)
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      end
    end

    # sqlite3.c no Xcode 16+: MAX/MIN; i64→int; #warning gethostuuid em iOS; vírgula em FK (amalgamação)
    # Xcode: umbrella gerado pelo CocoaPods usa #import "..." — Clang exige <> em framework headers
    if target.name == 'share_plus'
      target.build_configurations.each do |config|
        config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
      end
    end

    if target.name == 'sqlite3'
      target.build_configurations.each do |config|
        cflags = config.build_settings['OTHER_CFLAGS'] || '$(inherited)'
        cflags = cflags.join(' ') if cflags.is_a?(Array)
        %w[
          -UMAX -UMIN
          -Wno-ambiguous-macro
          -Wno-shorten-64-to-32
          -Wno-cpp
          -Wno-comma
          -Wno-unreachable-code
        ].each do |flag|
          cflags = "#{cflags} #{flag}" unless cflags.include?(flag)
        end
        config.build_settings['OTHER_CFLAGS'] = cflags.strip
        # Evita que #warning do sqlite3.c (ex.: gethostuuid no iOS) vire falha de build
        config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
      end
    end

    # live_activities (pub): Swift 6 + SDK recente — ActivityState.pending e capturas Sendable no Task.
    if target.name == 'live_activities'
      target.build_configurations.each do |config|
        config.build_settings['SWIFT_STRICT_CONCURRENCY'] = 'minimal'
      end
    end
  end

  installer.aggregate_targets.each do |aggregate_target|
    project = aggregate_target.user_project
    next unless project

    # Flutter.xcframework no Runner: GeneratedPluginRegistrant.m usa @import app_links →
    # app_links-Swift.h com @import Flutter; sem isto o Clang dá "module 'Flutter' not found"
    # (Pods-Runner.xcconfig só lista os pods, não o engine).
    flutter_root = nil
    gen = File.expand_path(File.join(__dir__, 'Flutter', 'Generated.xcconfig'))
    if File.exist?(gen)
      File.foreach(gen) do |line|
        m = line.match(/^FLUTTER_ROOT=(.*)$/)
        if m
          flutter_root = m[1].strip
          break
        end
      end
    end
    engine_debug = flutter_root && File.join(flutter_root, 'bin', 'cache', 'artifacts', 'engine', 'ios', 'Flutter.xcframework')
    engine_release = flutter_root && File.join(flutter_root, 'bin', 'cache', 'artifacts', 'engine', 'ios-release', 'Flutter.xcframework')

    project.native_targets.each do |t|
      next unless t.name == 'Runner'

      # Xcode 15+: com disable_input_output_paths, [CP] Copy Pods Resources nao tem outputs;
      # silencia o aviso com alwaysOutOfDate (= desliga dependency analysis no Xcode).
      t.build_phases.each do |phase|
        next unless phase.respond_to?(:name) && phase.name == '[CP] Copy Pods Resources'
        phase.always_out_of_date = '1' if phase.respond_to?(:always_out_of_date=)
      end

      t.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'

        use_debug_engine = config.name == 'Debug'
        xcf = use_debug_engine ? engine_debug : engine_release
        next unless xcf && Dir.exist?(xcf)

        Dir.children(xcf).sort.each do |child|
          next if child.start_with?('.')
          full = File.join(xcf, child)
          next unless File.directory?(full)

          if child.end_with?('-simulator')
            k = 'FRAMEWORK_SEARCH_PATHS[sdk=iphonesimulator*]'
            cur = config.build_settings[k] || '$(inherited)'
            cur = cur.join(' ') if cur.is_a?(Array)
            next if cur.include?(full)

            config.build_settings[k] = "\"#{full}\" #{cur}".strip
          elsif child.start_with?('ios-')
            k = 'FRAMEWORK_SEARCH_PATHS[sdk=iphoneos*]'
            cur = config.build_settings[k] || '$(inherited)'
            cur = cur.join(' ') if cur.is_a?(Array)
            next if cur.include?(full)

            config.build_settings[k] = "\"#{full}\" #{cur}".strip
          end
        end
      end
    end

    project.save
  end

  # share_plus: remove ramo morto com keyWindow (iOS mínimo 13; Clang avisa no else inalcançável).
  share_m = File.expand_path('.symlinks/plugins/share_plus/ios/share_plus/Sources/share_plus/FPPSharePlusPlugin.m', __dir__)
  if File.exist?(share_m)
    src = File.read(share_m)
    old_fn = <<~'OBJC'
static UIViewController *RootViewController(void) {
  if (@available(iOS 13, *)) { // UIApplication.keyWindow is deprecated
    NSSet *scenes = [[UIApplication sharedApplication] connectedScenes];
    for (UIScene *scene in scenes) {
      if ([scene isKindOfClass:[UIWindowScene class]]) {
        NSArray *windows = ((UIWindowScene *)scene).windows;
        for (UIWindow *window in windows) {
          if (window.isKeyWindow) {
            return window.rootViewController;
          }
        }
      }
    }
    return nil;
  } else {
    return [UIApplication sharedApplication].keyWindow.rootViewController;
  }
}
OBJC
    new_fn = <<~'OBJC'
static UIViewController *RootViewController(void) {
  NSSet *scenes = [[UIApplication sharedApplication] connectedScenes];
  for (UIScene *scene in scenes) {
    if ([scene isKindOfClass:[UIWindowScene class]]) {
      NSArray *windows = ((UIWindowScene *)scene).windows;
      for (UIWindow *window in windows) {
        if (window.isKeyWindow) {
          return window.rootViewController;
        }
      }
    }
  }
  return nil;
}
OBJC
    if src.include?('keyWindow.rootViewController')
      patched = src.sub(old_fn, new_fn)
      File.write(share_m, patched) if patched != src
    end
  end

  # live_activities: ActivityKit ainda expõe tipos não-Sendable; Swift 6 avisa sem @preconcurrency.
  live_activities_swift = File.expand_path('.symlinks/plugins/live_activities/ios/live_activities/Sources/live_activities/LiveActivitiesPlugin.swift', __dir__)
  if File.exist?(live_activities_swift)
    las = File.read(live_activities_swift)
    unless las.include?('@preconcurrency import ActivityKit')
      las = las.sub(/^import ActivityKit(\r?\n)/, "@preconcurrency import ActivityKit\\1")
    end
    # ContentState só com appGroupId: ActivityKit pode não re-renderizar no lock screen quando só muda App Group.
    unless las.include?('var refreshToken: Int64')
      las = las.sub(
        "        public struct ContentState: Codable, Hashable {\n            var appGroupId: String\n        }",
        "        public struct ContentState: Codable, Hashable {\n            var appGroupId: String\n            var refreshToken: Int64\n        }"
      )
      las = las.sub(
        'let initialContentState = LiveActivitiesAppAttributes.LiveDeliveryData(appGroupId: appGroupId!)',
        "let initialContentState = LiveActivitiesAppAttributes.LiveDeliveryData(\n            appGroupId: appGroupId!,\n            refreshToken: Int64(Date().timeIntervalSince1970 * 1000))"
      )
      las = las.sub(
        'let updatedStatus = LiveActivitiesAppAttributes.LiveDeliveryData(appGroupId: self.appGroupId!)',
        "let updatedStatus = LiveActivitiesAppAttributes.LiveDeliveryData(\n                appGroupId: self.appGroupId!,\n                refreshToken: Int64(Date().timeIntervalSince1970 * 1000))"
      )
    end
    # FlutterSceneLifeCycleDelegate: no ObjC o método devolve BOOL; assinatura Swift tem de ser -> Bool.
    unless las.include?('openURLContexts URLContexts: Set<UIOpenURLContext>) -> Bool')
      las = las.sub(
        'public func scene(_ scene: UIScene, openURLContexts URLContexts: Set<UIOpenURLContext>) {',
        'public func scene(_ scene: UIScene, openURLContexts URLContexts: Set<UIOpenURLContext>) -> Bool {'
      )
      las = las.sub(
        "        guard let url = URLContexts.first?.url else { return }\n        _ = handleURL(url)",
        "        guard let url = URLContexts.first?.url else { return false }\n        return handleURL(url)"
      )
    end
    # SDK recente: ActivityState.pending (ex. Live Activity agendada) — switch tem de listar o caso.
    unless las.include?('case .pending:')
      las = las.sub(
        "        case .stale:\n            return \"stale\"\n        @unknown default:\n            return \"unknown\"",
        "        case .stale:\n            return \"stale\"\n        case .pending:\n            return \"pending\"\n        @unknown default:\n            return \"unknown\""
      )
      las = las.sub(
        "                case .stale:\n                    DispatchQueue.main.async {\n                        var response: Dictionary<String, Any> = Dictionary()\n                        response[\"activityId\"] = activity.id\n                        response[\"status\"] = \"stale\"\n                        self.activityEventSink?.self(response)\n                    }\n                @unknown default:",
        "                case .stale:\n                    DispatchQueue.main.async {\n                        var response: Dictionary<String, Any> = Dictionary()\n                        response[\"activityId\"] = activity.id\n                        response[\"status\"] = \"stale\"\n                        self.activityEventSink?.self(response)\n                    }\n                case .pending:\n                    break\n                @unknown default:"
      )
    end
    # Swift 6: Task {} é @Sendable; evita DispatchQueue.main.async { self… } dentro do for await.
    if las.include?('pushToStartTokenUpdates') && las.include?('self.pushToStartTokenEventSink?(token)') && !las.include?('Task { @MainActor in')
      las = las.sub(
        "            Task {\n                for await data in Activity<LiveActivitiesAppAttributes>.pushToStartTokenUpdates {\n                    let token = data.map { String(format: \"%02x\", $0) }.joined()\n                    \n                    DispatchQueue.main.async {\n                        self.pushToStartTokenEventSink?(token)\n                    }\n                }\n            }",
        "            Task { @MainActor in\n                for await data in Activity<LiveActivitiesAppAttributes>.pushToStartTokenUpdates {\n                    let token = data.map { String(format: \"%02x\", $0) }.joined()\n                    self.pushToStartTokenEventSink?(token)\n                }\n            }"
      )
    end
    # Swift 6: monitorLiveActivity / monitorTokenChanges — Task @MainActor + sem DispatchQueue (evita avisos Sendable).
    if las.include?('for await state in activity.activityStateUpdates') && las.include?('DispatchQueue.main.async') && las.include?('case .pending:')
      old_mon = <<'SWIFT'
        Task {
            for await state in activity.activityStateUpdates {
                switch state {
                case .active:
                    monitorTokenChanges(activity)
                case .dismissed, .ended:
                    DispatchQueue.main.async {
                        var response: Dictionary<String, Any> = Dictionary()
                        response["activityId"] = activity.id
                        response["status"] = "ended"
                        self.activityEventSink?.self(response)
                    }
                case .stale:
                    DispatchQueue.main.async {
                        var response: Dictionary<String, Any> = Dictionary()
                        response["activityId"] = activity.id
                        response["status"] = "stale"
                        self.activityEventSink?.self(response)
                    }
                case .pending:
                    break
                @unknown default:
                    DispatchQueue.main.async {
                        var response: Dictionary<String, Any> = Dictionary()
                        response["activityId"] = activity.id
                        response["status"] = "unknown"
                        self.activityEventSink?.self(response)
                    }
                }
            }
        }
SWIFT
      new_mon = <<'SWIFT'
        Task { @MainActor in
            for await state in activity.activityStateUpdates {
                switch state {
                case .active:
                    monitorTokenChanges(activity)
                case .dismissed, .ended:
                    var response: Dictionary<String, Any> = Dictionary()
                    response["activityId"] = activity.id
                    response["status"] = "ended"
                    self.activityEventSink?.self(response)
                case .stale:
                    var response: Dictionary<String, Any> = Dictionary()
                    response["activityId"] = activity.id
                    response["status"] = "stale"
                    self.activityEventSink?.self(response)
                case .pending:
                    break
                @unknown default:
                    var response: Dictionary<String, Any> = Dictionary()
                    response["activityId"] = activity.id
                    response["status"] = "unknown"
                    self.activityEventSink?.self(response)
                }
            }
        }
SWIFT
      las = las.sub(old_mon, new_mon) if las.include?('DispatchQueue.main.async')
    end
    if las.include?('for await data in activity.pushTokenUpdates') && las.include?('DispatchQueue.main.async')
      old_tok = <<'SWIFT'
        Task {
            for await data in activity.pushTokenUpdates {
                DispatchQueue.main.async {
                    var response: Dictionary<String, Any> = Dictionary()
                    let pushToken = data.map {String(format: "%02x", $0)}.joined()
                    response["token"] = pushToken
                    response["activityId"] = activity.id
                    response["status"] = "active"
                    self.activityEventSink?.self(response)
                }
            }
        }
SWIFT
      new_tok = <<'SWIFT'
        Task { @MainActor in
            for await data in activity.pushTokenUpdates {
                var response: Dictionary<String, Any> = Dictionary()
                let pushToken = data.map {String(format: "%02x", $0)}.joined()
                response["token"] = pushToken
                response["activityId"] = activity.id
                response["status"] = "active"
                self.activityEventSink?.self(response)
            }
        }
SWIFT
      las = las.sub(old_tok, new_tok)
    end
    File.write(live_activities_swift, las)
  end

  # permission_handler_apple: ramo pre-iOS 12 usa subscriberCellularProvider (deprecated); app mínimo é 13.
  phone_strategy = File.expand_path('.symlinks/plugins/permission_handler_apple/ios/Classes/strategies/PhonePermissionStrategy.m', __dir__)
  if File.exist?(phone_strategy)
    ph = File.read(phone_strategy)
    old_phone = <<~'OBJC'
-(bool) canDevicePlaceAPhoneCall {
  CTTelephonyNetworkInfo *netInfo = [[CTTelephonyNetworkInfo alloc] init];
  
  if(@available(iOS 12.0, *)) {
    NSDictionary<NSString *, CTCarrier *> *providers = [netInfo serviceSubscriberCellularProviders];
    for (NSString *key in providers) {
      CTCarrier *carrier = [providers objectForKey:key];
      if ([self canPlacePhoneCallWithCarrier:carrier]) {
        return YES;
      }
    }
    
    return NO;
  } else {
    CTCarrier *carrier = [netInfo subscriberCellularProvider];
    return [self canPlacePhoneCallWithCarrier:carrier];
  }
}
OBJC
    new_phone = <<~'OBJC'
-(bool) canDevicePlaceAPhoneCall {
  CTTelephonyNetworkInfo *netInfo = [[CTTelephonyNetworkInfo alloc] init];
  NSDictionary<NSString *, CTCarrier *> *providers = [netInfo serviceSubscriberCellularProviders];
  for (NSString *key in providers) {
    CTCarrier *carrier = providers[key];
    if ([self canPlacePhoneCallWithCarrier:carrier]) {
      return YES;
    }
  }
  return NO;
}
OBJC
    if ph.include?('subscriberCellularProvider')
      ph_patched = ph.sub(old_phone, new_phone)
      File.write(phone_strategy, ph_patched) if ph_patched != ph
    end
  end
end
