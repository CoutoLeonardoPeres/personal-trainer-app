// Application-level settings for the Runner target.
//
// Versão de marketing e build: mesma fonte que iOS/Android (`pubspec.yaml` → Flutter-Generated).
#include "../../Flutter/ephemeral/Flutter-Generated.xcconfig"
MARKETING_VERSION = $(FLUTTER_BUILD_NAME)
CURRENT_PROJECT_VERSION = $(FLUTTER_BUILD_NUMBER)

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = app_personal

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.personaltrainer.app.Personal

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 com.personaltrainer.app.Personal. All rights reserved.
